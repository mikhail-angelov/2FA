<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera: QR scanning. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Network: issuer favicons only (no account data ever leaves the device). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scanning is optional: manual entry works on a device without a camera. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      allowBackup=false: an authenticator's database must never ride along in Android's
      cloud backup. Export/import (encrypted, password-protected) is the only way out.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TwoFactor"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
